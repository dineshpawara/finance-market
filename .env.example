# Compose Project
COMPOSE_PROJECT_NAME=finance_market

# Frontend Published Port (Host)
FRONTEND_PORT=3000

# TimescaleDB / PostgreSQL Database Name
POSTGRES_DB=finance_market

# RedisInsight GUI Port (Bound strictly to localhost 127.0.0.1 for security)
REDISINSIGHT_PORT=5540

