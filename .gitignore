# ==============================================================================
# Finance Market - Root .gitignore
# ==============================================================================

# Virtual Environments
.venv/
backend/.venv/
Include/
Lib/
Scripts/
share/
pyvenv.cfg

# Python bytecode & cache
__pycache__/
*.py[cod]
*.class
.pytest_cache/

# Local databases & runtime dynamic cache
*.db
*.sqlite
*.sqlite3
news_cache.json

# Environment variables & secrets (NEVER commit to GitHub)
.env
.env.*
!.env.example
secrets/
*.key
*.pem
*.crt
*.csr
*.srl

# Frontend dependencies & build artifacts
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS configuration
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

#ruleset
.github/rulesets/